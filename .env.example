# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=land_coordinates_db

# Copernicus Data Space Ecosystem Credentials
CDSE_USERNAME=your_email@example.com
CDSE_PASSWORD=your_password
CDSE_CLIENT_ID=cdse-public

# Copernicus API URLs
CDSE_BASE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_S3_URL=https://eodata.dataspace.copernicus.eu

# Copernicus S3 Credentials
CDSE_S3_ACCESS_KEY=your_s3_access_key
CDSE_S3_SECRET_KEY=your_s3_secret_key 